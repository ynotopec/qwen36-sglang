# Required. Generate a private value; the launcher refuses an empty key.
API_KEY=

#MODEL_PATH=nvidia/Qwen3.6-35B-A3B-NVFP4
#SERVED_MODEL_NAME=qwen3.6

#TP_SIZE=1
#MEM_FRACTION_STATIC=0.5
#CONTEXT_LENGTH=262144
#MAX_RUNNING_REQUESTS=8
#MAX_QUEUED_REQUESTS=12
# Set to 1 to omit the wrapper's context/request limits and sampling defaults.
#USE_SGLANG_DEFAULTS=0
# Optional: set to pass --chunked-prefill-size; leave unset to omit the flag.
# CHUNKED_PREFILL_SIZE=4096
# Optional: set to pass --max-prefill-tokens; leave unset to omit the flag.
# MAX_PREFILL_TOKENS=8192
# Valid examples: auto, fp8_e4m3, fp8_e5m2, bf16, bfloat16, fp4_e2m1
#KV_CACHE_DTYPE=fp8_e4m3

#ENABLE_TOOLS=1
#ENABLE_MTP=1
#ENABLE_MIXED_CHUNK=0
# Set to 0 to omit the default SGLang --sleep-on-idle flag.
#ENABLE_SLEEP_ON_IDLE=1

#HF_HOME=${HOME}/.cache/huggingface
#HF_HUB_CACHE=${HF_HOME}/hub
#TRANSFORMERS_CACHE=${HF_HUB_CACHE}

#HTTP_PORT=8080
# HOST controls the published listen address; PUBLISH_PORT can differ from the container port.
#HOST=0.0.0.0
#PUBLISH_PORT=8080
#SHM_SIZE=16g
#GPU_DEVICE=all
#RESTART_POLICY=unless-stopped

# Optional runtime tuning
# TORCHINDUCTOR_COMPILE_THREADS=2
# TOOL_SERVER=http://127.0.0.1:3001
# SPECULATIVE_ALGORITHM=NEXTN
# SPECULATIVE_DRAFT_MODEL_PATH=organization/draft-model
# SPECULATIVE_NUM_STEPS=3
# SPECULATIVE_EAGLE_TOPK=1
# SPECULATIVE_NUM_DRAFT_TOKENS=4

# Needed only if ENABLE_MTP=1
#SGLANG_ENABLE_SPEC_V2=1
#MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
# MAMBA_SSM_DTYPE=float32
# Use the NVFP4-compatible MoE implementation instead of flashinfer_trtllm.
#MOE_RUNNER_BACKEND=flashinfer_cutlass

# -----------------------------------------------------------------------------
# Minimal profile reproducing the documented nvidia/Qwen3.6-35B-A3B-NVFP4
# SGLang v0.5.15.post1-cu130 launch. Copy these values into .env and set a
# private API_KEY. Existing wrapper defaults supply TP_SIZE=1, context length,
# parsers, draft settings, and the mamba cache strategy.
# -----------------------------------------------------------------------------
# BASE_IMAGE=lmsysorg/sglang:v0.5.15.post1-cu130
# MODEL_PATH=nvidia/Qwen3.6-35B-A3B-NVFP4
# MEM_FRACTION_STATIC=0.70
# MAX_RUNNING_REQUESTS=16
# MAX_QUEUED_REQUESTS=64
# CHUNKED_PREFILL_SIZE=8192
# MAX_PREFILL_TOKENS=8192
# KV_CACHE_DTYPE=fp8_e4m3
# TRUST_REMOTE_CODE=1
# ENABLE_MTP=1
# SPECULATIVE_ALGORITHM=EAGLE

# Watchdog for stuck /health (detokenizer heartbeat timeouts)
#HEALTHCHECK_MONITOR_START_GRACE=900
#HEALTHCHECK_MONITOR_INTERVAL=15
#HEALTHCHECK_MONITOR_MAX_FAILURES=8

# HF_TOKEN=hf_xxx
# ADMIN_API_KEY=change-me-admin-token

# Build / image settings
# Select the upstream SGLang Docker image/tag used by install.sh.
#BASE_IMAGE=lmsysorg/sglang:latest-runtime
# IMAGE_NAME=qwen36-sglang:latest
# CONTAINER_NAME=qwen36-sglang
# UPGRADE_SGLANG=0
# UPGRADE_TRANSFORMERS=0
# SGLANG_WHL_INDEX=https://docs.sglang.ai/whl/cu130/
# FLASHINFER_DISABLE_VERSION_CHECK=1

# -----------------------------------------------------------------------------
# DFlash profile matching the RadixArk/Qwen3.8-27B-NVFP4 launch documented in
# README.md. Copy these values into .env and set a private API_KEY. Then run
# ./run.sh without positional arguments.
# -----------------------------------------------------------------------------
# DFlash2 support is not available in every stable SGLang runtime. Rebuild the
# wrapper with the CUDA 13 development image when selecting this profile.
# BASE_IMAGE=lmsysorg/sglang:dev-cu13
# MODEL_PATH=RadixArk/Qwen3.8-27B-NVFP4
# SERVED_MODEL_NAME=qwen3.8
# HTTP_PORT=30000
# MEM_FRACTION_STATIC=0.80
# USE_SGLANG_DEFAULTS=1
# TRUST_REMOTE_CODE=1
# ATTENTION_BACKEND=flashinfer
# CHUNKED_PREFILL_SIZE=2048
# MAMBA_FULL_MEMORY_RATIO=11.01
# MAMBA_RADIX_CACHE_STRATEGY=extra_buffer_lazy
# MAMBA_SSM_DTYPE=float32
# ENABLE_SLEEP_ON_IDLE=0
# SPECULATIVE_ALGORITHM=DFLASH
# SPECULATIVE_DRAFT_MODEL_PATH=incoai/Qwen3.8-27B-DFlash2
# SPECULATIVE_NUM_DRAFT_TOKENS=8

# -----------------------------------------------------------------------------
# Experimental Flash-Next profile. The checkpoint currently identifies itself
# as model_type=qwen4_exp, so the stable runtime's bundled Transformers/SGLang
# registry may be too old. Use the development image's matched Transformers
# package; upgrading Transformers independently causes duplicate config names.
# Rebuild after selecting this profile; do not merely restart an old image.
# -----------------------------------------------------------------------------
# BASE_IMAGE=lmsysorg/sglang:dev-cu13
# UPGRADE_TRANSFORMERS=0
# MODEL_PATH=RadixArk/Qwen3.8-Flash-Next-NVFP4
# SERVED_MODEL_NAME=qwen3.8
# MEM_FRACTION_STATIC=0.80
# TRUST_REMOTE_CODE=1
# ENABLE_MTP=1
# SPECULATIVE_ALGORITHM=NEXTN
# SPECULATIVE_NUM_DRAFT_TOKENS=4
# SPECULATIVE_NUM_STEPS=3
# SPECULATIVE_EAGLE_TOPK=1
# MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
