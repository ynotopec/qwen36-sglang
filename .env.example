API_KEY=change-me-very-strong-token

#MODEL_PATH=Qwen/Qwen3.6-35B-A3B-FP8
#SERVED_MODEL_NAME=qwen3.6

#TP_SIZE=1
#MEM_FRACTION_STATIC=0.5
#CONTEXT_LENGTH=262144
#MAX_RUNNING_REQUESTS=8
#MAX_QUEUED_REQUESTS=8
#CHUNKED_PREFILL_SIZE=4096
# Valid examples: auto, fp8_e4m3, fp8_e5m2, bf16, bfloat16, fp4_e2m1
#KV_CACHE_DTYPE=fp8_e4m3

#ENABLE_MULTIMODAL=1
#ENABLE_TOOLS=1
#ENABLE_MTP=1
# Keep MTP enabled by default; set to 1 for an image-safe server profile.
#DISABLE_MTP_WITH_MULTIMODAL=0
#ENABLE_MIXED_CHUNK=0

#HF_HOME=${HOME}/.cache/huggingface
#HF_HUB_CACHE=${HF_HOME}
#TRANSFORMERS_CACHE=${HF_HOME}

#HTTP_PORT=8080
#SHM_SIZE=16g
#GPU_DEVICE=all
#RESTART_POLICY=unless-stopped

# Optional runtime tuning
# TORCHINDUCTOR_COMPILE_THREADS=2
# TOOL_SERVER=http://127.0.0.1:3001
# SPECULATIVE_NUM_STEPS=3
# SPECULATIVE_EAGLE_TOPK=1
# SPECULATIVE_NUM_DRAFT_TOKENS=4

# Needed only if ENABLE_MTP=1
#SGLANG_ENABLE_SPEC_V2=1
#MAMBA_SCHEDULER_STRATEGY=extra_buffer

# Watchdog for stuck /health (detokenizer heartbeat timeouts)
#HEALTHCHECK_MONITOR_START_GRACE=900
#HEALTHCHECK_MONITOR_INTERVAL=15
#HEALTHCHECK_MONITOR_MAX_FAILURES=8

# HF_TOKEN=hf_xxx
# ADMIN_API_KEY=change-me-admin-token

# Build / image settings
# IMAGE_NAME=qwen36-sglang:latest
# CONTAINER_NAME=qwen36-sglang
# UPGRADE_SGLANG=0
# UPGRADE_TRANSFORMERS=0
# SGLANG_WHL_INDEX=https://docs.sglang.ai/whl/cu130/
# FLASHINFER_DISABLE_VERSION_CHECK=1
